# Each entry under `targets` is an independent combination of task source,
# agent and project folder. A single run of robottles picks exactly one
# target by name, e.g.:
#
#   robottles config.yaml project2
#
# If only one target is configured, the name can be omitted.
targets:
  project1:
    source:
      # Which task supplier to use. Currently supported: "caldav", "dummy".
      type: caldav
      # Full URL to the CalDAV task-list (VTODO) collection.
      url: "https://example.com/remote.php/dav/calendars/myuser/tasks/"
      username: "myuser"
      # App password / token used as the basic-auth password.
      token: "my-app-token"

    project:
      # Local folder Claude should work in when solving the picked task.
      path: "/home/myuser/projects/project1"
      # Whether to commit and push Claude's changes to git after each task.
      # Defaults to true; set to false to leave changes uncommitted in the
      # working tree instead.
      commit_changes: true

  project2:
    # To try things out without a real task supplier, use the dummy source
    # instead (it always hands back a single "make no changes" task):
    source:
      type: dummy

    project:
      path: "/home/myuser/projects/project2"
      # Use a local LM Studio server instead of the `claude` CLI. Requires
      # LM Studio's local server to be running with a model loaded.
      agent:
        type: lmstudio
        # Base URL of LM Studio's OpenAI-compatible API. Defaults to
        # "http://localhost:1234/v1".
        base_url: "http://localhost:1234/v1"
        # Which model to request. Optional; if omitted, LM Studio uses
        # whichever model is currently loaded.
        model: "qwen2.5-coder-32b"
        # Maximum number of tool-calling round trips before giving up.
        # Defaults to 20.
        max_iterations: 20
        # How long to wait for each chat-completion request before giving
        # up, in seconds. Local models can take a long time to think, so
        # this defaults to 1800 (30 minutes).
        timeout_secs: 1800
